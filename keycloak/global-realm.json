{
  "realm": "global-realm",
  "enabled": true,
  "displayName": "Global Identity Broker",
  "roles": {
    "realm": [
      { "name": "admin" },
      { "name": "member" },
      { "name": "user" }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "admin@123" }],
      "realmRoles": ["admin"],
	  "emailVerified":true,
	  "email": "global.admin@amazingminutes.com",
	  "realmRoles": ["admin"] 
    }
  ],
  "clients": [
    {
      "clientId": "backend-service",
	  "secret": "backend-secret-key",
      "directAccessGrantsEnabled": true,
      "publicClient": false,
	  "authorizationServicesEnabled": true,
	  "protocol": "openid-connect",
      "redirectUris": ["*"]
    }
  ],
  "groups": [
    {
      "name": "Admins-BLR",
      "realmRoles": ["admin"]
    },
    {
      "name": "Members-BLR",
      "realmRoles": ["member"]
    },
	{
      "name": "Users-BLR",
      "realmRoles": ["user"]
    }
  ],
  "identityProviders": [
    {
      "alias": "realm-bangalore",
      "displayName": "bangalore Region",
      "providerId": "keycloak-oidc",
      "enabled": true,
	  "trustEmail": true,
      "config": {
        "authorizationUrl": "http://keycloak-bangalore.local/:8080/realms/realm-bangalore/protocol/openid-connect/auth",
        "tokenUrl": "http://keycloak-bangalore.local:8080/realms/realm-baganlore/protocol/openid-connect/token",
        "clientId": "backend-service",
        "clientSecret": "backend-secret-key"
      }
    }
  ]
  
}
